---
import { pagePath } from "../paths";
import Anchor from "./Anchor.astro";
import PixelIcon from "./PixelIcon.astro";
import TitleMenu from "./TitleMenu.astro";

const path = pagePath(Astro.url);
const isPost = path.startsWith("/blog/");
---

<header class="site-header border-fg bg-bg sticky top-0 z-10 w-full border-b-4">
  {/* The house leads home, and the pages are in the menu (TitleMenu.astro). */}
  <nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3">
    <Anchor
      url="/"
      underline={false}
      aria-label="Home"
      aria-current={path === "/" ? "page" : undefined}
      class="group -ml-2 px-2 py-1"
    >
      <PixelIcon
        name="house"
        class="transition-transform duration-150 ease-out motion-safe:group-hover:-translate-y-1 motion-safe:group-focus-visible:-translate-y-1"
      />
    </Anchor>
    <div class="flex items-center gap-4">
      <button id="themeToggle" aria-label="Dark theme" aria-pressed="false">
        <PixelIcon name="sun" class="dark:hidden" />
        <PixelIcon name="moon" class="hidden dark:block" />
      </button>
      {/* A link, so that it still leads to the menu where the script does not run. */}
      <a id="menuOpen" href="#menu" aria-label="Menu">
        <PixelIcon name="menu" />
      </a>
    </div>
  </nav>
  {/* On a post, the header's bottom border fills up as the reader scrolls. */}
  {isPost && <div class="read-progress bg-accent absolute -bottom-1 left-0 h-1 w-full" />}
</header>
<TitleMenu />

<style>
  /* Hidden where the browser cannot tie an animation to the scroll position. */
  .read-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @keyframes fill {
      from {
        transform: scaleX(0);
      }
    }

    .read-progress {
      display: block;
      transform-origin: left;
      animation: fill linear both;
      animation-timeline: scroll(root block);
    }
  }
</style>

<script is:inline>
  const root = document.documentElement;
  const themeToggle = document.getElementById("themeToggle");
  // The button is a switch for the dark theme, so it says whether that theme is on.
  const showState = () =>
    themeToggle?.setAttribute("aria-pressed", String(root.classList.contains("dark")));
  showState();

  const toggleTheme = () => {
    root.classList.toggle("dark");
    showState();
    try {
      localStorage.setItem("theme", root.classList.contains("dark") ? "dark" : "light");
    } catch {
      // Without storage the choice lasts until the page is left.
    }
  };

  // The themes cross-fade where the browser can do it and the person has not asked for
  // reduced motion.
  const handleToggleClick = () => {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (still || !document.startViewTransition) {
      toggleTheme();
      return;
    }
    root.classList.add("theme-fade");
    document
      .startViewTransition(toggleTheme)
      .finished.finally(() => root.classList.remove("theme-fade"));
  };

  themeToggle?.addEventListener("click", handleToggleClick);
</script>
