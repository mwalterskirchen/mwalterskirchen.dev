---
import Anchor from "./Anchor.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  duration?: string;
  timestamp?: Date;
  external?: boolean;
};

const { title, description, url, duration, timestamp, external } = Astro.props;

const formattedDate = timestamp
  ? `${timestamp.toLocaleString("default", { month: "short" })} ${timestamp.getDate()}, ${timestamp.getFullYear()}`
  : null;
---

<div class="hover-marker relative mb-8 flex flex-col gap-3">
  <Anchor url={url} external={external} class="text-xl">
    {title}
  </Anchor>
  <p>{description}</p>
  <div class="text-muted flex items-center justify-between">
    {formattedDate ? <p>{formattedDate}</p> : null}
    {duration ? <p>{duration}</p> : null}
  </div>
</div>
