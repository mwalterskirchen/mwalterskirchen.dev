---
import Anchor from "./Anchor.astro";
import PixelIcon from "./PixelIcon.astro";

export type Props = {
  title: string;
  description: string;
  url: string;
  duration?: string;
  timestamp?: Date;
  external?: boolean;
};

const { title, description, url, duration, timestamp, external } = Astro.props;

const formattedDate = timestamp
  ? `${timestamp.toLocaleString("default", { month: "short" })} ${timestamp.getDate()}, ${timestamp.getFullYear()}`
  : null;
---

<div class="group relative mb-8 flex flex-col gap-3">
  {/* The same selection cursor as the 404 menu. It needs the wide gutter, so it is desktop only. */}
  <PixelIcon
    name="cursor"
    class="text-accent invisible absolute top-1.5 -left-7 hidden group-focus-within:visible group-hover:visible md:block"
  />
  <Anchor url={url} external={external} underline={false} class="text-xl">
    {title}
  </Anchor>
  <p>{description}</p>
  <div class="text-muted flex items-center justify-between">
    {formattedDate ? <p>{formattedDate}</p> : null}
    {duration ? <p>{duration}</p> : null}
  </div>
</div>
