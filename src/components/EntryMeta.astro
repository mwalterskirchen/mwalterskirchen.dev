---
type Props = {
  timestamp?: Date;
  /** Shown after the date: the reading time of an article or the event of a talk. */
  detail?: string;
};

const { timestamp, detail } = Astro.props;
// The locale and time zone are fixed, so a build gives the same dates on any machine.
const formattedDate = timestamp
  ? timestamp.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
      timeZone: "Europe/Zurich",
    })
  : null;
---

<p class="text-muted flex flex-wrap gap-x-6 text-sm md:text-base">
  {formattedDate ? <time datetime={timestamp?.toISOString()}>{formattedDate}</time> : null}
  {detail ? <span>{detail}</span> : null}
</p>
