---
import { config } from "../config";
import Anchor from "./Anchor.astro";
import PixelIcon from "./PixelIcon.astro";
import Section from "./Section.astro";

const year = new Date().getFullYear();
---

<footer class="mt-16 mb-8">
  <Section class="mb-4">
    <div class="border-fg flex items-center justify-center gap-4 border-b-4 pb-4">
      <Anchor
        url={config.personal.githubProfile}
        aria-label={`${config.personal.name} GitHub Profile`}
      >
        <PixelIcon name="github" />
      </Anchor>
      <Anchor
        url={config.personal.linkedinProfile}
        aria-label={`${config.personal.name} LinkedIn Profile`}
      >
        <PixelIcon name="linkedin" />
      </Anchor>
    </div>
  </Section>
  <p class="text-center text-sm font-medium">
    &copy; {year} {config.personal.name}. All rights reserved.
  </p>
</footer>
