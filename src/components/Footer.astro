---
import { config } from "../config";
import Anchor from "./Anchor.astro";
import PixelIcon from "./PixelIcon.astro";
import Section from "./Section.astro";

const year = new Date().getFullYear();

const links = [
  { icon: "github", label: "GitHub", url: config.personal.githubProfile },
  { icon: "linkedin", label: "LinkedIn", url: config.personal.linkedinProfile },
  { icon: "rss", label: "RSS feed", url: "/rss.xml" },
] as const;
---

<footer class="mt-16 mb-8">
  <Section>
    <div class="border-fg flex items-center justify-between gap-4 border-t-4 pt-6">
      <p class="text-sm">
        &copy; {year} {config.personal.name}
      </p>
      <ul class="flex items-center gap-4">
        {links.map((link) => (
          <li>
            <Anchor url={link.url} aria-label={link.label} class="group">
              <PixelIcon
                name={link.icon}
                class="transition-transform duration-150 ease-out group-hover:-translate-y-1 group-focus-visible:-translate-y-1"
              />
            </Anchor>
          </li>
        ))}
      </ul>
    </div>
  </Section>
</footer>
