---
import { config } from "../config";
import Anchor from "./Anchor.astro";
import Lilly from "./Lilly.astro";
import PixelIcon from "./PixelIcon.astro";

const year = new Date().getFullYear();

const links = [
  { icon: "github", label: "GitHub", url: config.personal.githubProfile },
  { icon: "linkedin", label: "LinkedIn", url: config.personal.linkedinProfile },
  { icon: "rss", label: "RSS feed", url: "/rss.xml" },
] as const;
---

<footer class="mt-8">
  <div class="ground relative" aria-hidden="true">
    <Lilly />
  </div>
  <div class="bg-panel">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 pt-4 pb-8">
      <p class="text-sm">
        &copy; {year} {config.personal.name}
      </p>
      <ul class="flex items-center gap-4">
        {links.map((link) => (
          <li>
            <Anchor url={link.url} aria-label={link.label} class="group">
              <PixelIcon
                name={link.icon}
                class="transition-transform duration-150 ease-out group-hover:-translate-y-1 group-focus-visible:-translate-y-1"
              />
            </Anchor>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
