---
import { config } from "../config";
import { draw } from "../lilly";
import { pagePath } from "../paths";
import PixelIcon from "./PixelIcon.astro";

// The site's menu, laid out like the title screen of a game: the name, Lilly, and the pages as
// the options. The header's menu link opens it (Header.astro).
const path = pagePath(Astro.url);
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);

const sitting = draw({ pose: "sit", step: 0, wag: false, blink: false, pant: 0 });
---

{/* The script opens this as a modal. Without the script, the menu link's `#menu` shows it
    through `target:` and the close link's `#` hides it again. */}
<dialog
  id="menu"
  aria-label="Menu"
  class="title-menu bg-bg text-fg fixed inset-0 z-30 m-0 size-full max-h-none max-w-none flex-col overflow-y-auto target:flex open:flex"
>
  {/* The close link is where the header's menu link is. */}
  <div class="mx-auto flex w-full max-w-3xl justify-end px-4 py-3">
    <a href="#" class="menu-close" aria-label="Close menu">
      <PixelIcon name="close" />
    </a>
  </div>
  <div class="flex grow flex-col items-center justify-center gap-8 px-4 pt-4 pb-12 text-center">
    <PixelIcon rows={sitting} scale={3} class="text-apricot" />
    <p class="font-display text-pixel-sm min-[340px]:text-pixel-md sm:text-pixel-lg">
      {config.site.name}
    </p>
    <ul class="font-display text-pixel-sm text-left capitalize">
      {config.nav.map((item) => (
        <li class="menu-item">
          {/* The cursor shows which option has focus, in place of the focus ring. */}
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class="flex items-center gap-4 pr-10 focus-visible:outline-none"
          >
            <PixelIcon name="cursor" scale={3} class="menu-cursor" />
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
  {/* Only where there is a keyboard to press. */}
  <p class="text-muted pointer-fine:block hidden pb-6 text-center text-sm font-medium">
    ↑↓ select · enter open · esc back
  </p>
</dialog>

<script is:inline>
  {
    const menu = document.getElementById("menu");
    const options = [...menu.querySelectorAll("li a")];

    // The cursor is on the option that has focus: at first the page the reader is on.
    document.getElementById("menuOpen").addEventListener("click", (event) => {
      event.preventDefault();
      menu.showModal();
      (menu.querySelector("[aria-current]") ?? options[0]).focus();
    });

    // A menu shown by `#menu` in the address is not open as a modal, and its close link
    // works as a link.
    menu.querySelector(".menu-close").addEventListener("click", (event) => {
      if (!menu.open) return;
      event.preventDefault();
      menu.close();
    });

    // The arrow keys move the cursor and wrap around at the ends. So does the pointer, so that
    // there is never a second cursor.
    menu.addEventListener("keydown", (event) => {
      const step = { ArrowDown: 1, ArrowUp: -1 }[event.key];
      if (!step) return;
      event.preventDefault();
      const at = options.indexOf(document.activeElement);
      options[(at + step + options.length) % options.length].focus();
    });
    for (const option of options) {
      option.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") option.focus();
      });
    }

    // A page that the Back button brings back from the cache comes back with its menu closed.
    window.addEventListener("pageshow", (event) => {
      if (event.persisted && menu.open) menu.close();
    });
  }
</script>
