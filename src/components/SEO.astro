---
import { getImage } from "astro:assets";
import { config } from "../config";
import { pagePath } from "../paths";
import avatar from "../assets/avatar.jpeg";

type Props = {
  /** The page's own title. The site name is added to the document title. */
  title: string;
  description: string;
  cardImage?: string;
  /** The tags of an article. */
  tags?: string[];
  /** Keeps the page out of search results, for a page with no address of its own (404). */
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string;
  authorName?: string;
};

const {
  title,
  description,
  cardImage,
  tags,
  noindex = false,
  type = "website",
  publishedTime,
  authorName,
} = Astro.props;

const path = pagePath(Astro.url);
const canonicalUrl = noindex ? undefined : new URL(path, Astro.site).href;

const siteName = config.site.name;
const isHome = path === "/";
const documentTitle = isHome ? title : `${title} • ${siteName}`;
const resolvedCardImage = cardImage ? new URL(cardImage, Astro.site).href : undefined;
// The cards that the site draws itself (src/pages/og) all have one size.
const isOwnCard = cardImage?.startsWith("/og/") ?? false;

// The home page describes the person the site is about, so that a search for the name finds it.
const personId = `${config.site.url}/#person`;
// The same picture as the portrait on the home page, not the full-size photo.
const portrait = await getImage({ src: avatar, width: 448, height: 448 });

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description,
        url: canonicalUrl,
        ...(resolvedCardImage && { image: resolvedCardImage }),
        ...(publishedTime && { datePublished: publishedTime }),
        ...(tags && { keywords: tags.join(", ") }),
        ...(authorName && {
          author: { "@type": "Person", name: authorName },
        }),
      }
    : isHome
      ? {
          "@context": "https://schema.org",
          "@graph": [
            {
              "@type": "WebSite",
              name: title,
              description,
              url: canonicalUrl,
              author: { "@id": personId },
            },
            {
              "@type": "Person",
              "@id": personId,
              name: config.personal.name,
              url: config.site.url,
              image: new URL(portrait.src, Astro.site).href,
              jobTitle: config.personal.jobTitle,
              worksFor: { "@type": "Organization", name: config.personal.employer },
              sameAs: [config.personal.githubProfile, config.personal.linkedinProfile],
            },
          ],
        }
      : {
          "@context": "https://schema.org",
          "@type": "WebPage",
          name: title,
          description,
          url: canonicalUrl,
        };

// Escaped so that no text in the data can close the script element.
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<title>{documentTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
{resolvedCardImage && (
  <>
    <meta property="og:image" content={resolvedCardImage} />
    <meta property="og:image:alt" content={title} />
  </>
)}
{isOwnCard && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === "article" && tags?.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{resolvedCardImage && <meta name="twitter:image" content={resolvedCardImage} />}
{resolvedCardImage && <meta name="twitter:image:alt" content={title} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{!noindex && <script type="application/ld+json" set:html={jsonLdHtml} />}
