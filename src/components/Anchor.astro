---
import PixelIcon from "./PixelIcon.astro";

export type Props = {
  url: string;
  class?: string;
  external?: boolean;
  /** Set to false for links that are obvious without it, such as nav items and entry titles. */
  underline?: boolean;
  "aria-label"?: string;
  "aria-current"?: "page";
};

const { url, external, underline = true, class: className } = Astro.props;
---

<a
  href={url}
  class:list={[
    "pixel-link",
    // An external link stays inline so that its arrow follows the last word when the text wraps.
    external ? "inline" : "flex items-center gap-1",
    // Without an underline at rest, the line is still there but clear, so that it can fade in.
    !underline && "decoration-transparent",
    className,
  ]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  aria-label={Astro.props["aria-label"]}
  aria-current={Astro.props["aria-current"]}
>
  <slot />
  {external ? (
    <>
      <PixelIcon name="external" class="ml-2 inline-block" />
      <span class="sr-only"> (opens in a new tab)</span>
    </>
  ) : null}
</a>
