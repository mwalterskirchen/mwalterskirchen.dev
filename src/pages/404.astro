---
import PixelIcon from "../components/PixelIcon.astro";
import Section from "../components/Section.astro";
import Layout from "../layouts/Layout.astro";
import SEO from "../components/SEO.astro";
---

<Layout>
  <Fragment slot="head">
    <SEO
      title="Not Found - 404"
      description="The page you are looking for does not exist."
      cardImage="/og/site.png"
      noindex
    />
  </Fragment>
  <Section class="mt-16">
    <h1 class="font-display text-pixel-lg">Game over</h1>
    <p class="pt-2 pb-12">404. This page does not exist. The link may be old or mistyped.</p>
    <h2 class="font-display text-pixel-sm">Continue?</h2>
    <ul class="continue pt-2 text-xl font-medium">
      {[
        { href: "/", label: "Go to the homepage" },
        { href: "/blog", label: "Read the blog" },
        { href: "/talks", label: "See the talks" },
      ].map((item) => (
        <li class="menu-item">
          <a href={item.href} class="flex items-center gap-3 py-1">
            <PixelIcon name="cursor" class="menu-cursor" />
            {item.label}
          </a>
        </li>
      ))}
      {/* Starts Lilly's run on the grass below (Lilly.astro). Shown only where she moves. */}
      <li class="menu-item play-lilly" hidden>
        <button type="button" class="flex items-center gap-3 py-1">
          <PixelIcon name="cursor" class="menu-cursor" />
          Play with Lilly
        </button>
      </li>
    </ul>
  </Section>
</Layout>

<script>
  const item = document.querySelector<HTMLElement>(".play-lilly");
  if (item && window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    item.hidden = false;
    item.querySelector("button")?.addEventListener("click", () => {
      window.dispatchEvent(new Event("lilly:play"));
    });
  }
</script>

<style is:global>
  /* Global because the cursor is drawn by a child component, which scoped styles do not reach.
     The cursor sits on the first option until another one is hovered or focused. */
  .continue:not(:hover, :focus-within) li:first-child .menu-cursor {
    opacity: 1;
  }
</style>
