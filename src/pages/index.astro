---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { byNewest, readTime } from "../entries";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Anchor from "../components/Anchor.astro";
import PixelIcon from "../components/PixelIcon.astro";
import PixelButton from "../components/PixelButton.astro";
import ArticleSnippet from "../components/ArticleSnippet.astro";
import SEO from "../components/SEO.astro";
import { config } from "../config";
import avatar from "../assets/avatar.jpeg";
import frames from "../assets/avatar-frames.png";

const featuredArticles = (await getCollection("blog", (e) => e.data.featured))
  .sort(byNewest)
  .map((e) => ({
    ...e.data,
    readTime: readTime(e),
    url: `/blog/${e.data.slug}`,
  }));

const featuredTalks = (await getCollection("talks", (e) => e.data.featured)).sort(byNewest);

const latestIssue = (await getCollection("newsletter")).sort(byNewest)[0];
---

<Layout>
  <Fragment slot="head">
    <SEO title={config.site.name} description={config.site.description} cardImage="/og/site.png" />
  </Fragment>

  <Section class="mt-8 md:mt-12">
    <div class="flex flex-col items-start gap-8 md:flex-row md:items-center">
      <div class="pixel-frame relative ml-1 size-42 shrink-0 [--frame-shadow:var(--color-accent)] sm:size-56">
        <Image
          src={avatar}
          alt="Portrait of Maximilian Walterskirchen"
          width={448}
          height={448}
          loading="eager"
          fetchpriority="high"
          class="size-full"
        />
        {/* A sprite sheet of three coarse copies of the photo, which covers it while it sharpens. */}
        <img src={frames.src} alt="" aria-hidden="true" class="frames absolute inset-0 size-full" />
      </div>
      <div>
        <h1 class="font-display text-pixel-sm min-[340px]:text-pixel-md sm:text-pixel-lg">
          Maximilian Walterskirchen
        </h1>
        <p class="mt-2 text-xl font-medium">Senior Software Engineer</p>
        <p class="text-muted mt-1 flex items-center gap-2 text-base">
          Zurich, Switzerland
          <PixelIcon name="swissFlag" />
        </p>
      </div>
    </div>
  </Section>

  <Section class="mt-4">
    <div class="flex flex-col items-start gap-4">
      <p class="mb-2 text-xl font-medium md:text-2xl md:leading-9">
        I build production software with AI in the loop and write about the engineering side of
        doing it well.
      </p>

      <p>
        At Staffgenius I work on{" "}
        <a href="https://inplan.ch" target="_blank" rel="noopener noreferrer" class="pixel-link">
          inplan
        </a>
        , where we use AI and agents to automate shift planning for Swiss hospitals. Before that I
        co-founded a luxury real estate marketplace and spent four years building web apps for
        Austrian enterprises. Six years in all, mostly in TypeScript.
      </p>

      <p>
        I'm interested in the boring engineering questions underneath the hype: how to make agents
        reliable, how to ship AI features that don't fall apart on contact with users, and how to
        stay a good engineer while the tools change underneath you.
      </p>

      <p>
        I co-write{" "}
        <a
          href={config.newsletter.url}
          target="_blank"
          rel="noopener noreferrer"
          class="pixel-link"
        >
          {config.newsletter.name}
        </a>
        , a weekly newsletter on agentic coding, and speak at{" "}
        <a href="https://zurichjs.com" target="_blank" rel="noopener noreferrer" class="pixel-link">
          ZurichJS
        </a>
        , where I also review conference talk submissions.
      </p>

      <PixelButton url={`mailto:${config.personal.email}`} class="mt-4">
        <PixelIcon
          name="mail"
          class="transition-[translate] duration-200 ease-out motion-safe:group-hover:translate-x-1 group-active:translate-x-0"
        />
        {/* The address is one long word, so on a narrow screen it has to break inside. */}
        <span class="min-w-0 break-all">{config.personal.email}</span>
      </PixelButton>
    </div>
  </Section>

  <Section class="mt-12">
    <div class="border-panel flex items-end justify-between gap-4 border-b-4 pb-2">
      <h2 class="font-display text-pixel-sm">Articles</h2>
      <Anchor url="/blog" class="mb-1 text-base font-medium">
        All articles
      </Anchor>
    </div>
    {featuredArticles.length === 0 ? (
      <p class="mt-8">No articles yet.</p>
    ) : (
      <ul class="mt-8 flex flex-col gap-10">
        {featuredArticles.map((article) => (
          <li>
            <ArticleSnippet
              heading="h3"
              title={article.title}
              description={article.description}
              url={article.url}
              timestamp={article.timestamp}
              detail={`${article.readTime} min read`}
            />
          </li>
        ))}
      </ul>
    )}
  </Section>

  {latestIssue && (
    <Section class="mt-12">
      <div class="border-panel flex items-end justify-between gap-4 border-b-4 pb-2">
        <h2 class="font-display text-pixel-sm">Newsletter</h2>
        <Anchor url="/newsletter" class="mb-1 text-base font-medium">
          All issues
        </Anchor>
      </div>
      <div class="mt-8">
        <ArticleSnippet
          heading="h3"
          title={latestIssue.data.title}
          description={latestIssue.data.description}
          url={latestIssue.data.url}
          timestamp={latestIssue.data.timestamp}
          detail={config.newsletter.name}
          external
        />
      </div>
    </Section>
  )}

  <Section class="mt-12">
    <div class="border-panel flex items-end justify-between gap-4 border-b-4 pb-2">
      <h2 class="font-display text-pixel-sm">Talks</h2>
      <Anchor url="/talks" class="mb-1 text-base font-medium">
        All talks
      </Anchor>
    </div>
    {featuredTalks.length === 0 ? (
      <p class="mt-8">No talks yet.</p>
    ) : (
      <ul class="mt-8 flex flex-col gap-10">
        {featuredTalks.map((talk) => (
          <li>
            <ArticleSnippet
              heading="h3"
              title={talk.data.title}
              description={talk.data.description}
              url={talk.data.slidesUrl ?? talk.data.repoUrl}
              timestamp={talk.data.timestamp}
              detail={talk.data.event}
              external
            />
          </li>
        ))}
      </ul>
    )}
  </Section>
</Layout>

<style>
  .frames {
    object-fit: cover;
    image-rendering: pixelated;
    visibility: hidden;
  }

  /* The portrait sharpens in four steps once the page has faded in. Each keyframe holds until
     the next one, and the last one uncovers the photo. */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes sharpen {
      0% {
        object-position: 0 0;
        visibility: visible;
      }
      25% {
        object-position: 50% 0;
        visibility: visible;
      }
      50% {
        object-position: 100% 0;
        visibility: visible;
      }
      75% {
        visibility: hidden;
      }
    }

    .frames {
      animation: sharpen 640ms step-end 240ms backwards;
    }
  }
</style>
