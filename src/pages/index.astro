---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Anchor from "../components/Anchor.astro";
import PixelIcon from "../components/PixelIcon.astro";
import ArticleSnippet from "../components/ArticleSnippet.astro";
import SEO from "../components/SEO.astro";
import { config } from "../config";
import avatar from "../../public/avatar.jpeg";

const featuredArticles = (await getCollection("blog", (e) => e.data.featured)).map((e) => ({
  ...e.data,
  url: `/blog/${e.data.slug}`,
}));

const featuredTalks = (await getCollection("talks", (e) => e.data.featured)).sort(
  (a, b) => b.data.timestamp.valueOf() - a.data.timestamp.valueOf(),
);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout>
  <Fragment slot="head">
    <SEO
      title="Maximilian Walterskirchen"
      description="Senior Software Engineer based in Zurich. Building AI-powered products with TypeScript."
      longDescription="Senior Software Engineer based in Zurich. Building AI-powered products with TypeScript."
      cardImage="/og/site.png"
      keywords={["software engineer", "AI", "LLM", "typescript", "web development"]}
      canonicalUrl={canonicalUrl}
    />
  </Fragment>

  <Section class="mt-8">
    <div class="flex flex-col items-start gap-8 sm:flex-row sm:items-center">
      <Image
        src={avatar}
        alt="Maximilian Walterskirchen Profile Image"
        width={320}
        height={320}
        class="pixel-frame mb-4 size-40 shrink-0 [--frame-shadow:var(--color-accent)] sm:mb-0"
      />
      <div>
        <h1 class="font-display text-pixel-sm min-[340px]:text-pixel-md sm:text-pixel-lg">
          Maximilian Walterskirchen
        </h1>
        <h2 class="font-mono text-xl font-medium sm:text-2xl">Senior Software Engineer</h2>
        <h3 class="flex items-center gap-2 font-mono text-sm sm:text-base">
          Zurich, Switzerland
          <PixelIcon name="swissFlag" />
        </h3>
      </div>
    </div>
  </Section>

  <Section>
    <div class="flex flex-col gap-4">
      <p>
        I build production software with AI in the loop and write about the engineering side of
        doing it well.
      </p>

      <p>
        Five years shipping scalable web apps in TypeScript. The last couple of years deep into
        LLM-powered features and agent orchestration in real products, not demos.
      </p>

      <p>
        I'm interested in the boring engineering questions underneath the hype: how to make agents
        reliable, how to ship AI features that don't fall apart on contact with users, and how to
        stay a good engineer while the tools change underneath you.
      </p>

      <p>
        Speaker and CFP reviewer @
        <a
          href="https://zurichjs.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:decoration-accent hover:decoration-4 underline decoration-2 underline-offset-[6px]"
        >
          ZurichJS
        </a>
        .
      </p>
      <a
        href={`mailto:${config.personal.email}`}
        class="hover:decoration-accent hover:decoration-4 flex items-center gap-2 underline decoration-2 underline-offset-8"
      >
        <PixelIcon name="mail" />
        Let's chat: {config.personal.email}
      </a>
    </div>
  </Section>

  <Section>
    <div class="flex w-full items-center justify-between">
      <h3 class="font-display text-pixel-sm">Articles</h3>
      <Anchor url="/blog" class="text-base">
        View All
      </Anchor>
    </div>
    <ul class="my-8">
      {(featuredArticles.length === 0 && <p>No articles found.</p>) ||
        featuredArticles.map((article, index) => (
          <li
            class:list={[
              "animate-in-up",
              index % 9 === 0 && "delay-0",
              index % 9 === 1 && "delay-1",
              index % 9 === 2 && "delay-2",
              index % 9 === 3 && "delay-3",
              index % 9 === 4 && "delay-4",
              index % 9 === 5 && "delay-5",
              index % 9 === 6 && "delay-6",
              index % 9 === 7 && "delay-7",
              index % 9 === 8 && "delay-8",
            ]}
          >
            <ArticleSnippet
              title={article.title}
              description={article.description}
              url={article.url}
              timestamp={article.timestamp}
              duration={`${article.readTime} min`}
            />
          </li>
        ))}
    </ul>
  </Section>

  <Section>
    <div class="flex w-full items-center justify-between">
      <h3 class="font-display text-pixel-sm">Talks</h3>
      <Anchor url="/talks" class="text-base">
        View All
      </Anchor>
    </div>
    <ul class="my-8">
      {(featuredTalks.length === 0 && <p>No talks found.</p>) ||
        featuredTalks.map((talk, index) => (
          <li
            class:list={[
              "animate-in-up",
              index % 9 === 0 && "delay-0",
              index % 9 === 1 && "delay-1",
              index % 9 === 2 && "delay-2",
              index % 9 === 3 && "delay-3",
              index % 9 === 4 && "delay-4",
              index % 9 === 5 && "delay-5",
              index % 9 === 6 && "delay-6",
              index % 9 === 7 && "delay-7",
              index % 9 === 8 && "delay-8",
            ]}
          >
            <ArticleSnippet
              title={talk.data.title}
              description={talk.data.description}
              url={talk.data.slidesUrl ?? talk.data.repoUrl}
              timestamp={talk.data.timestamp}
              duration={talk.data.event}
              external
            />
          </li>
        ))}
    </ul>
  </Section>
</Layout>
