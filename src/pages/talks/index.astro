---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ArticleSnippet from "../../components/ArticleSnippet.astro";
import Section from "../../components/Section.astro";
import SEO from "../../components/SEO.astro";

const talks = (await getCollection("talks")).sort(
  (a, b) => b.data.timestamp.valueOf() - a.data.timestamp.valueOf(),
);
---

<Layout>
  <Fragment slot="head">
    <SEO
      title="Talks"
      description="Talks I've given at meetups and conferences."
      cardImage="/og/site.png"
    />
  </Fragment>
  <Section class="my-8">
    <h1 class="font-display text-pixel-md border-panel border-b-4 pt-4 pb-2">Talks</h1>
    <ul class="mt-10 flex flex-col gap-10">
      {talks.map((talk) => (
        <li>
          <ArticleSnippet
            title={talk.data.title}
            description={talk.data.description}
            detail={talk.data.event}
            url={talk.data.slidesUrl ?? talk.data.repoUrl}
            timestamp={talk.data.timestamp}
            external
          />
        </li>
      ))}
    </ul>
  </Section>
</Layout>
