---
import { getCollection } from "astro:content";
import { byNewest, readTime } from "../../entries";
import Layout from "../../layouts/Layout.astro";
import ArticleSnippet from "../../components/ArticleSnippet.astro";
import Section from "../../components/Section.astro";
import SEO from "../../components/SEO.astro";

const articles = (await getCollection("blog")).sort(byNewest);
---

<Layout>
  <Fragment slot="head">
    <SEO
      title="Blog"
      description="Practical wisdom, unfiltered thoughts, and hot takes."
      cardImage="/og/site.png"
    />
  </Fragment>
  <Section class="my-8">
    <h1 class="font-display text-pixel-md border-panel border-b-4 pt-4 pb-2">Articles</h1>
    <ul class="mt-10 flex flex-col gap-10">
      {articles.map((article) => (
        <li>
          <ArticleSnippet
            title={article.data.title}
            description={article.data.description}
            detail={`${readTime(article)} min read`}
            url={`/blog/${article.data.slug}`}
            timestamp={article.data.timestamp}
          />
        </li>
      ))}
    </ul>
  </Section>
</Layout>
