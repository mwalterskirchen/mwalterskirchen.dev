---
import { config } from "../config";
import type { ArticleFrontmatter } from "../content.config";
import Anchor from "../components/Anchor.astro";
import EntryMeta from "../components/EntryMeta.astro";
import Section from "../components/Section.astro";
import SEO from "../components/SEO.astro";
import Layout from "./Layout.astro";

type Props = { frontmatter: ArticleFrontmatter };

const { frontmatter } = Astro.props;
const { timestamp } = frontmatter;
const isoDate = timestamp.toISOString();
---

<Layout>
  <Fragment slot="head">
    <SEO
      title={frontmatter.title}
      description={frontmatter.description}
      cardImage={frontmatter.cardImage ?? `/og/${frontmatter.slug}.png`}
      tags={frontmatter.tags}
      type="article"
      publishedTime={isoDate}
      modifiedTime={frontmatter.updated?.toISOString()}
      authorName={config.personal.name}
    />
  </Fragment>
  <Section class="pt-8">
    <article>
      <header class="border-panel mt-4 mb-12 border-b-4 pb-6">
        <EntryMeta timestamp={timestamp} detail={`${frontmatter.readTime} min read`} />
        <h1 class="font-display text-pixel-sm md:text-pixel-md mt-4">{frontmatter.title}</h1>
      </header>
      <div class="prose md:prose-lg blog-prose max-w-none">
        <slot />
      </div>
      <footer class="border-panel mt-16 flex flex-wrap items-center justify-between gap-4 border-t-4 pt-6">
        <p class="text-muted text-base">~{config.personal.name}</p>
        <Anchor url="/blog" class="text-base font-medium">
          All articles
        </Anchor>
      </footer>
    </article>
  </Section>
</Layout>
