---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "@fontsource/ibm-plex-mono/latin-400";
import "@fontsource/ibm-plex-mono/latin-400-italic";
import "@fontsource/ibm-plex-mono/latin-500";
import "@fontsource/ibm-plex-mono/latin-600";
import "@fontsource/ibm-plex-mono/latin-700";
import "@fontsource/jersey-10/latin-400.css";
import plexMono from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="font" type="font/woff2" href={plexMono} crossorigin="anonymous" />
    <!-- Theme detection script - runs before page renders -->
    <script is:inline>
      // A theme is stored only once the toggle is used (Header.astro). Until then the page
      // follows the system setting.
      {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Without storage the page follows the system setting.
        }
        const dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      }
    </script>
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg relative flex min-h-dvh flex-col font-mono md:text-lg">
    {/* The body fills the screen so that the footer's ground sits at the bottom of a short page. */}
    <div class="sky" aria-hidden="true">
      <div class="sky-far"></div>
      <div class="sky-near"></div>
    </div>
    <Header />
    <main class="grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
