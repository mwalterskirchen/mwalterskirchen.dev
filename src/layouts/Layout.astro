---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { config } from "../config";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-400-italic.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-700.css";
import "@fontsource/jersey-10/latin-400.css";
import plexMono from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={config.site.name} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="font" type="font/woff2" href={plexMono} crossorigin="anonymous" />
    {/* The colour of the browser's own bars: the page background. The script keeps it in step. */}
    <meta name="theme-color" content="#e8ecf1" />
    <!-- Theme detection script - runs before page renders -->
    <script is:inline>
      // Sets the theme, and the colour of the browser's bars with it. The toggle in
      // Header.astro calls it too.
      window.setTheme = (dark) => {
        document.documentElement.classList.toggle("dark", dark);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", dark ? "#1a1c2c" : "#e8ecf1");
      };

      // A theme is stored only once the toggle is used. Until then the page follows the
      // system setting.
      {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Without storage the page follows the system setting.
        }
        const dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        window.setTheme(dark);
      }
    </script>
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg relative flex min-h-dvh flex-col font-mono md:text-lg">
    {/* The body fills the screen so that the footer's ground sits at the bottom of a short page. */}
    <div class="sky" aria-hidden="true">
      <div class="sky-far"></div>
      <div class="sky-near"></div>
    </div>
    {/* The first stop for the Tab key. It is above the screen until it has focus. */}
    <a
      href="#main"
      class="pixel-frame bg-bg fixed top-4 left-4 z-20 -translate-y-24 px-3 py-2 font-medium focus:translate-y-0"
    >
      Skip to content
    </a>
    <Header />
    {/* The scroll margin keeps the sticky header off the top of the content after a skip. */}
    <main id="main" class="grow scroll-mt-20">
      <slot />
    </main>
    <Footer />
  </body>
</html>
